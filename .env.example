# Note: Copy these variables in your .env file
#   cp .env.example .env
# Secrets: prefer ./deploy.sh (or deploy.ps1), which generates missing values.
# Do not put real secrets in docker-compose.yml — updates replace that file.

# Database. The bundled Postgres runs automatically and needs no
# configuration — it is not exposed outside the Docker network.
#
# POSTGRES_PASSWORD is required for the bundled database. Generate once:
#   openssl rand -base64 24
# Changing it after the volume exists will prevent the app from connecting
# until you reset the volume (data loss) or restore the old password.
# POSTGRES_PASSWORD=

# To use your own Postgres instead, uncomment and set BOTH lines.
# Without BUNDLED_DB=0 an unused bundled database container still starts.
# DATABASE_URL=postgres://user:pass@db.example.internal:5432/jobsync
# BUNDLED_DB=0
#
# For local development (npm run dev) DATABASE_URL must be set: point it at
# any Postgres you can reach. See CONTRIBUTING.md.

# If you are running it on a remote server/homelab, you must update timezone otherwise activities times may shift
TZ=America/Edmonton

# For homelab server, change the following to your server ip ex: http://192.168.x.x:3737
NEXTAUTH_URL=http://localhost:3737

# Required when the app is not served from localhost (homelab ip, reverse proxy)
AUTH_TRUST_HOST=true

# AUTH_SECRET signs sessions. deploy.sh / deploy.ps1 generate a stable value
# in .env on first run. If unset, docker-entrypoint.sh generates a temporary
# secret for that container boot only (sessions reset on recreate).
# Generate manually: openssl rand -base64 32
# AUTH_SECRET=

# ENCRYPTION_KEY encrypts API keys saved in Settings (OpenAI, DeepSeek, etc.).
# Must be stable across restarts — changing it makes stored keys unrecoverable.
# Required. Generate with: openssl rand -base64 32
# ENCRYPTION_KEY=

# Optional: set provider keys here, or leave empty and add them in Settings
# after sign-in (Settings keys are encrypted with ENCRYPTION_KEY).
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# RAPIDAPI_KEY=

# For homelab server, if ollama is running on the server, change the following
# to your ollama IP, e.g. http://192.168.x.x:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# AI Configuration
# The system uses LLM-based semantic extraction for intelligent, context-aware skill matching
# No configuration needed - semantic extraction is the default

# Enables the MCP server in production (default: on in dev, off in prod)
MCP_ENABLED=true

# Observability (OTel traces + logs to a self-hosted OpenObserve instance)
# Off by default — leave all four commented out for no change in behaviour.
# Base URL only; the app appends /v1/traces and /v1/logs itself
# OTEL_EXPORTER_OTLP_ENDPOINT=http://homelab:5080/api/default
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic base64(email:token)
# OTEL_SERVICE_NAME=jobsync
# Also captures prompt/response content on LLM spans — has no effect unless OTEL_EXPORTER_OTLP_ENDPOINT above is also set
# OTEL_CAPTURE_CONTENT=false
